# ==========================================
# ThreatRadar Environment Variables Template
# ==========================================
# Usage: Copy this file to '.env' and replace the placeholder values.
# DO NOT commit the actual '.env' file to version control.

# GitHub API Configuration (for dependency scanning)
# Used by: github_scanner module
GITHUB_TOKEN=your_github_personal_access_token_here

# NVD API Configuration (for vulnerability feeds)
# Used by: crawler module
NVD_API_KEY=your_nvd_api_key_here

# ============================================================
# LLM backend: "ollama" (local, default) or "openai" (hosted API)
# Used by: analyzer module. config.py auto-loads this .env on import.
# ============================================================
LLM_PROVIDER=ollama

# ---- Option A: local Ollama (LLM_PROVIDER=ollama) ----------
# Needs the Ollama daemon running + the model pulled. Defaults shown.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---- Option B: hosted OpenAI-compatible API (LLM_PROVIDER=openai) ----
# For teammates without a local GPU. Works with any OpenAI-compatible
# /chat/completions endpoint. Set all three:
#
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1
#               OPENAI_MODEL=gpt-4o-mini
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#               OPENAI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#               OPENAI_MODEL=qwen/qwen-2.5-7b-instruct
#   Local Ollama via its OpenAI-compatible port (no API cost, for testing):
#               OPENAI_BASE_URL=http://localhost:11434/v1
#               OPENAI_API_KEY=ollama
#               OPENAI_MODEL=qwen2.5:7b
#
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# ==========================================
# ThreatRadar Environment Variables Template
# ==========================================
# Usage: Copy this file to '.env' and replace the placeholder values.
# DO NOT commit the actual '.env' file to version control.

# GitHub API Configuration (for dependency scanning)
# Used by: github_scanner module — raises the contents-API limit to 5000 req/hr.
GITHUB_TOKEN=your_github_personal_access_token_here

# NVD API Configuration (for vulnerability feeds)
# Used by: crawler module — raises the NVD rate limit. Optional.
NVD_API_KEY=your_nvd_api_key_here
# Max NVD pages fetched per crawl (resultsPerPage=20 each). Caps demo crawl time.
NVD_MAX_PAGES=5

# ------------------------------------------------------------------
# PRIMARY_PROVIDER — which model is AUTHORITATIVE (fills the dashboard + retries):
#   local   use the Ollama model below (default; works fully offline)
#   cloud   use the online API in the CLOUD_LLM_* block (DeepSeek, Qwen, OpenAI...)
# Switch the whole pipeline between local and online by changing this one value.
PRIMARY_PROVIDER=local

# ANALYSIS_MODE — whether a SECOND model also runs (for comparison):
#   single   only the primary model (default)
#   compare  run primary + the other model on every item, store both
#   hybrid   primary on every item; the other only re-checks HIGH/CRITICAL items
ANALYSIS_MODE=single

# ------------------------------------------------------------------
# Cloud LLM provider — vendor-neutral, any OpenAI-compatible /chat/completions
# endpoint works. Set PRIMARY_PROVIDER=cloud to make this the main analyzer, or
# use it as the second model via ANALYSIS_MODE=compare/hybrid. Leave the API key
# empty to keep it disabled. Presets (use the provider's current model id):
#   DeepSeek: BASE_URL=https://api.deepseek.com/v1                       MODEL=deepseek-chat
#   Qwen:     BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 MODEL=qwen-plus
#   OpenAI:   BASE_URL=https://api.openai.com/v1                         MODEL=gpt-4o-mini
#   Groq / Together / OpenRouter / local vLLM ... all OpenAI-compatible too.
CLOUD_LLM_PROVIDER=openai-compatible
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_API_KEY=your_cloud_llm_api_key_here
CLOUD_LLM_TIMEOUT=120

# Bump when you change the analysis prompt so stored results stay comparable.
PROMPT_VERSION=v1
